{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "feature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "repository": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,38})$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]{1,100}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "owner",
        "name",
        "commit",
        "license"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "pre-generated",
            "generated",
            "local-import"
          ]
        },
        "review": {
          "type": "string",
          "enum": [
            "source-checked",
            "unreviewed"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2400
        }
      },
      "required": [
        "kind",
        "review",
        "note"
      ],
      "additionalProperties": false
    },
    "dataMode": {
      "type": "string",
      "const": "illustrative"
    },
    "steps": {
      "minItems": 5,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 35
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2400
          },
          "insight": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2400
          },
          "input": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          },
          "output": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          },
          "transition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "references": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                }
              },
              "required": [
                "path",
                "startLine",
                "endLine",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "branches": {
            "minItems": 2,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 80,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2400
                },
                "output": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1200
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "reference": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "startLine": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16000
                    }
                  },
                  "required": [
                    "path",
                    "startLine",
                    "endLine",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "label",
                "explanation",
                "output",
                "reference"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "label",
          "explanation",
          "insight",
          "input",
          "output",
          "transition",
          "references"
        ],
        "additionalProperties": false
      }
    },
    "connections": {
      "minItems": 4,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "to": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "summary",
    "feature",
    "language",
    "repository",
    "provenance",
    "dataMode",
    "steps",
    "connections"
  ],
  "additionalProperties": false
}

# Optional. Built-in tours require no credentials.
# Server-side only; never prefix secrets with NEXT_PUBLIC_.
REPOPLAY_GITHUB_TOKEN=
# OpenAI-compatible chat/completions endpoint. Configure all three to enable generation.
REPOPLAY_MODEL_ENDPOINT=
REPOPLAY_MODEL_NAME=
REPOPLAY_MODEL_API_KEY=
# Enable only after a real RepoPlay repository exists; use https://github.com/owner/repo.
NEXT_PUBLIC_REPOPLAY_REPOSITORY=
